#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
API_DIR="$PROJECT_DIR/../rides-api"

echo "🚀 Starting rides-api..."

if [ ! -d "$API_DIR" ]; then
  echo "❌ Error: rides-api directory not found at $API_DIR"
  exit 1
fi

if [ ! -f "$API_DIR/bin/serve" ]; then
  echo "❌ Error: rides-api serve script not found at $API_DIR/bin/serve"
  exit 1
fi

# Start the API in the background
cd "$API_DIR"
./bin/serve &
API_PID=$!

# Wait for API to be ready
echo "⏳ Waiting for rides-api to be ready..."
MAX_ATTEMPTS=30
ATTEMPT=0

while [ $ATTEMPT -lt $MAX_ATTEMPTS ]; do
  if curl -s http://localhost:3001/health > /dev/null 2>&1; then
    echo "✅ rides-api is ready!"
    break
  fi
  ATTEMPT=$((ATTEMPT + 1))
  sleep 1
done

if [ $ATTEMPT -eq $MAX_ATTEMPTS ]; then
  echo "❌ Error: rides-api failed to start within 30 seconds"
  kill $API_PID 2>/dev/null || true
  exit 1
fi

# Start the Next.js dev server
cd "$PROJECT_DIR"
echo "🚀 Starting Next.js dev server..."
yarn dev

# Cleanup on exit
trap "kill $API_PID 2>/dev/null || true" EXIT
