#!/usr/bin/env bash
# Run this script - `./bin/start-database`

container system start

DB_CONTAINER_NAME="bcc3-postgres"

if ! [ -x "$(command -v container)" ]; then
  echo -e "container is not installed. Please install container and try again."
  exit 1
fi

# This command is not working as expected
if container ls | grep "$DB_CONTAINER_NAME"; then
  echo "Database container '$DB_CONTAINER_NAME' running"
  exit 0
fi

if container ls -a | grep "$DB_CONTAINER_NAME"; then
  echo "Database container '$DB_CONTAINER_NAME' started"
  exit 0
fi

# import env variables from .env
set -a
source .env

DB_PASSWORD=$(echo "$DATABASE_URL" | awk -F':' '{print $3}' | awk -F'@' '{print $1}')

echo $DB_PASSWORD

if [ "$DB_PASSWORD" = "password" ]; then
  echo "You are using the default database password"
  read -p "Should we generate a random password for you? [y/N]: " -r REPLY
  if ! [[ $REPLY =~ ^[Yy]$ ]]; then
    echo "Please set a password in the .env file and try again"
    exit 1
  fi
  # Generate a random URL-safe password
  DB_PASSWORD=$(openssl rand -base64 12 | tr '+/' '-_')
  sed -i -e "s#:password@#:$DB_PASSWORD@#" .env
fi

container run -d \
  --name $DB_CONTAINER_NAME \
  -e POSTGRES_USER="postgres" \
  -e POSTGRES_PASSWORD="$DB_PASSWORD" \
  -e POSTGRES_DB=bcc3 \
  docker.io/postgres && echo "Database container '$DB_CONTAINER_NAME' was successfully created"