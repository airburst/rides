# Club name
NEXT_PUBLIC_CLUB_LONG_NAME='Bath Cycling Club'
NEXT_PUBLIC_CLUB_SHORT_NAME=BCC

# Hosting
NEXT_PUBLIC_REPO=https://github.com/x/repo
HOST_URL=https://public-app.com

# External API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Drizzle
DATABASE_URL=postgresql://postgres:password@localhost:5432/dbname
SOURCE_URL=postgresql://postgres:password@localhost:5432/dbname

# Next Auth (legacy - being removed)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Auth0 (server-side - optional, being removed)
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Auth0 (client-side SPA)
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.your-app.com

# API Key for GitHub cron jobs
API_KEY=
